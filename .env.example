# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit the real .env file.
# Every variable here MUST be validated at boot by packages/config (see
# packages/config/src/env.ts) — the app fails fast if any are missing.
#
# Lines marked SECRET must never be committed with a real value, never be
# logged (loadEnv redacts them), and never be copied to a NEXT_PUBLIC_*
# name — Next.js inlines those into client JavaScript, where they are
# world-readable forever. assertNoPublicSecrets() refuses to start if that
# has happened.
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL / Prisma ---
# SECRET — the connection string carries a password.
# Local dev value matches docker-compose.yml's postgres service.
DATABASE_URL="postgresql://acos:acos_dev_password@localhost:5432/acos_dev?schema=public"

# --- Razorpay ---
# Publishable — this one is sent to the browser for Checkout.
RAZORPAY_KEY_ID=
# SECRET
RAZORPAY_KEY_SECRET=
# SECRET. Forging this forges payment confirmations; see docs/WEBHOOKS.md.
RAZORPAY_WEBHOOK_SECRET=

# --- Meta Conversions API ---
META_PIXEL_ID=
# SECRET
META_CAPI_ACCESS_TOKEN=
META_CAPI_API_VERSION=v20.0

# --- Anthropic (AI research, outreach and proposal generation) ---
# SECRET. Required at boot by any process that runs the AI engine.
# Passed explicitly to createAnthropicResearchModel — never read from the
# ambient environment by the SDK.
ANTHROPIC_API_KEY=

# --- Multi-Model Research Provider (OpenAI / Gemini) ---
# OPTIONAL. Anthropic above remains required; these are only needed if
# RESEARCH_PROVIDER or RESEARCH_FALLBACK_PROVIDER selects that vendor.
# An Anthropic-only deployment can leave both blank.
# SECRET
OPENAI_API_KEY=
# SECRET
GEMINI_API_KEY=
# anthropic | openai | gemini. Defaults to anthropic.
RESEARCH_PROVIDER=anthropic
# Provider-specific model identifier. Optional — each adapter has its own default.
RESEARCH_MODEL=
# Optional single fallback provider (anthropic | openai | gemini). Absent
# by default: no fallback occurs unless set.
RESEARCH_FALLBACK_PROVIDER=
RESEARCH_FALLBACK_MODEL=

# --- Digital delivery ---
# SECRET. HMAC key for signed download grants. MINIMUM 32 CHARACTERS —
# a short key makes a grant signature forgeable, and a forged grant is
# unpaid access to a paid product. Generate one with:
#   openssl rand -base64 48
DOWNLOAD_GRANT_SECRET=

# --- Google Places API, New (Phase 18 production DiscoveryProvider) ---
# SECRET. Required at boot by apps/worker. Sent only via the
# X-Goog-Api-Key header, never a query string.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_API_BASE_URL=https://places.googleapis.com/v1
DISCOVERY_REQUEST_TIMEOUT_MS=10000

# --- Source document acquisition (Phase 18 SourceDocumentProvider) ---
# Homepage-only HTTP fetch + Readability extraction. NOT a secret.
SOURCE_FETCH_TIMEOUT_MS=10000
SOURCE_FETCH_MAX_BYTES=2000000
SOURCE_FETCH_USER_AGENT=ACOS-ResearchBot/1.0

# --- Worker / Outbox dispatcher ---
WORKER_POLL_INTERVAL_MS=15000
WORKER_BATCH_SIZE=25
WORKER_MAX_ATTEMPTS=5

# --- Data retention ---
# Days the verbatim Razorpay webhook body is kept before it is narrowed
# to the audit allowlist. NOT a secret. Bounded 30..400; the default of
# 180 is set by the card-network chargeback window (~120 days) plus time
# to answer one. Below 120 you are choosing to forfeit card-dispute
# forensics. See docs/SECURITY.md "Webhook payload retention".
WEBHOOK_PAYLOAD_RETENTION_DAYS=180

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Claim/setup link email (DEC-014) ---
# Absolute origin this deployment is served from, used to build the
# claim link URL mailed to a buyer. NOT a secret.
APP_BASE_URL=http://localhost:3000
# No production transactional email provider is implemented yet. Leave
# unset for local dev (claim links are logged to the console instead of
# emailed). Setting this to a provider name without an implementation in
# @acos/core-entitlements' createClaimEmailSender fails at send time.
#
# 'gmail-dev' is the one exception: a development-only real-SMTP sender
# (see GMAIL_DEV_USER/GMAIL_DEV_APP_PASSWORD below). It is refused
# outright if NODE_ENV=production, so it can never become a silent
# production default.
EMAIL_PROVIDER=

# --- Development Gmail claim-email delivery (EMAIL_PROVIDER=gmail-dev) ---
# Lets a developer actually receive a DEC-014 claim email in a real
# inbox before a production provider (Resend etc.) is configured.
# NEVER used in production — createClaimEmailSender refuses this
# provider name whenever NODE_ENV=production, regardless of these being set.
#
# GMAIL_DEV_USER: the sending Gmail address, e.g.
#   clientacquisition.project@gmail.com
#
# GMAIL_DEV_APP_PASSWORD: a Gmail App Password for that account — NOT
# its normal login password, which Gmail's SMTP will reject. To create
# one: the Google Account must have 2-Step Verification turned on, then
# generate an App Password at https://myaccount.google.com/apppasswords
# (select "Mail" as the app). Paste the 16-character result here with
# no spaces. This cannot be generated from inside this environment — it
# requires signing in to that Google account yourself.
GMAIL_DEV_USER=
GMAIL_DEV_APP_PASSWORD=
