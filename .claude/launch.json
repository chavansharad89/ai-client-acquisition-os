{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-only",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@acos/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3777"
      ],
      "port": 3777
    }
  ]
}
